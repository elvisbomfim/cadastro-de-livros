{
    "name": "elvisbomfim/cadastro-de-livros",
    "description": "App com PHP - Cadastro de Livros",
    "authors": [
        {
            "name": "Elvis Bomfim de Souza",
            "email": "elvis@bravosite.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "Core\\": "src/Core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.1",
        "mockery/mockery": "^1.6"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require": {
        "ramsey/uuid": "^4.9"
    }
}
